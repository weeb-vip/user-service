enum Language {
    TH
    EN
}

type User @key(fields: "id") {
    id: ID!
    firstname: String!
    lastname: String!
    username: String!
    language: Language!
    email: String
    profileImageUrl: String
    "The wide header image behind the profile."
    bannerImageUrl: String
    "A short line the user writes about themselves."
    bio: String
    "A palette token name that themes the page, e.g. \"violet\"."
    accentColor: String
    "Whether this user's watch and read lists are shown on their public page."
    listsPublic: Boolean!
    "Whether a follow must be approved by this user before it is live."
    followApprovalRequired: Boolean!
}

"""
The safe subset of a User, for anyone to see.

A separate type rather than the whole User, so a public query can never be
widened into email, sessions, or language just by selecting more fields. Only
what a page header renders is here.
"""
type PublicUser @key(fields: "id") {
    id: ID!
    username: String!
    firstname: String!
    lastname: String!
    profileImageUrl: String
    bannerImageUrl: String
    bio: String
    accentColor: String
    "Whether the lists section is shown. False means the header stands alone."
    listsPublic: Boolean!
    "Whether a follow must be approved before it is live. Also hides the follower and following lists from non-followers."
    followApprovalRequired: Boolean!
    "Accepted followers. Always visible, even when the list itself is not."
    followerCount: Int! @goField(forceResolver: true)
    "Accepted follows. Always visible, even when the list itself is not."
    followingCount: Int! @goField(forceResolver: true)
    "How the current viewer relates to this user. NONE when not signed in."
    viewerFollowStatus: FollowStatus! @goField(forceResolver: true)
}

"""
The viewer's relationship to a user, from the viewer's side.
"""
enum FollowStatus {
    "No edge, or not signed in."
    NONE
    "The viewer asked to follow and the user has not yet approved."
    REQUESTED
    "The viewer follows the user."
    FOLLOWING
    "The viewer is looking at themselves."
    SELF
}

"""
A page of users, for follower and following lists. Same page/limit/total shape
as the list-service pages so one client component renders both.
"""
type PublicUserPaginated {
    page: Int!
    limit: Int!
    total: Int!
    users: [PublicUser!]!
}

input CreateUserInput {
    id: String!
    firstname: String!
    lastname: String!
    username: String!
    language: Language!
    email: String
}

input UpdateUserInput {
    firstname: String
    lastname: String
    username: String
    email: String
    language: Language
    profileImageUrl: String
    bio: String
    accentColor: String
    listsPublic: Boolean
    followApprovalRequired: Boolean
}